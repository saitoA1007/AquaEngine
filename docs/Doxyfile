# Sphinx(Breathe)用のXMLを出力するためのDoxygen設定
PROJECT_NAME           = "AquaEngine"
OUTPUT_DIRECTORY       = _doxygen
INPUT                  = ../Project/EngineSource
INPUT_ENCODING         = UTF-8
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp
EXCLUDE_PATTERNS       = */Externals/*
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = ../Project/EngineSource
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
PREDEFINED             = USE_IMGUI WINAPI= CALLBACK=
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_LOGFILE           = _doxygen/warnings.log
